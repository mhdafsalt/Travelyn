# ==============================================================================
# Travelyn Backend Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Port (default: 5000)
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# Allowed CORS Origins (* for all, or comma-separated list like http://localhost:3000)
CORS_ORIGIN=*

# Frontend Application URL
FRONTEND_URL=http://localhost:3000

# API Route Prefix
API_PREFIX=/api

# JWT Authentication Secret (for future session / user auth tokens)
JWT_SECRET=travelyn_luxury_jwt_secret_key_2026

# Optional Database Connection String (e.g. MongoDB, PostgreSQL)
# DATABASE_URL=mongodb://localhost:27017/travelyn

# Optional SMTP Mail Configuration (for booking confirmations & concierge inquiries)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="Travelyn Concierge" <concierge@travelyn.com>
