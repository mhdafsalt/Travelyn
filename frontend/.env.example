# ==============================================================================
# Travelyn Frontend Environment Variables Template
# Copy this file to .env.local and adjust for your environment.
# ==============================================================================

# Backend REST API endpoint (exposed to the browser client)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Backend Server URL (used by Next.js server-side rewrites in next.config.js)
BACKEND_URL=http://localhost:5000

# Frontend Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application Branding
NEXT_PUBLIC_APP_NAME=Travelyn

# Optional AI Service Keys (for AI Travel Planner live LLM mode)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional Analytics & Tracking
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
