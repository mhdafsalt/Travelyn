{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node -e \"const fs=require('fs'),cp=require('child_process'); if(fs.existsSync('frontend/package.json')){cp.execSync('npm --prefix frontend install',{stdio:'inherit'})}else{cp.execSync('npm install',{stdio:'inherit'})}\"",
  "buildCommand": "node -e \"const fs=require('fs'),cp=require('child_process'); if(fs.existsSync('frontend/package.json')){cp.execSync('npm --prefix frontend run build',{stdio:'inherit'})}else{cp.execSync('npm run build',{stdio:'inherit'})}\"",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs"
}
