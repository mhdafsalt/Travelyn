{
  "name": "travelyn-platform",
  "version": "1.0.0",
  "description": "Travelyn - Luxury Travel & Journeys Fullstack Platform (Next.js Frontend + Express Backend)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start": "npm --prefix frontend start",
    "start:frontend": "npm --prefix frontend start",
    "start:backend": "npm --prefix backend start",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "author": "Travelyn",
  "license": "MIT"
}
